# SO-101 rig — arms + cameras, rebuilt from scratch 2026-08-24.
# Arms (WCH CH343 serial adapters, matched by unique serial):
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5AE6052778", SYMLINK+="so101_leader",   GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5B7B009740", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"

# Cameras (matched by USB vid:pid, index 0 = the capture node):
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="05a3", ATTRS{idProduct}=="9230", ATTR{index}=="0", SYMLINK+="cam_wrist", GROUP="video", MODE="0660"
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="328f", ATTRS{idProduct}=="0073", ATTR{index}=="0", SYMLINK+="cam_top",   GROUP="video", MODE="0660"

# Disable USB autosuspend on both cameras (prevents mid-run ENODEV dropouts):
SUBSYSTEM=="usb", ATTR{idVendor}=="05a3", ATTR{idProduct}=="9230", TEST=="power/control", ATTR{power/control}="on"
SUBSYSTEM=="usb", ATTR{idVendor}=="328f", ATTR{idProduct}=="0073", TEST=="power/control", ATTR{power/control}="on"
